    {
      "parameters": {
        "jsCode": "const results = [];\nfor (const item of $input.all()) {\n  const hsEmail = item.json.hs_email;\n  const atEmail = item.json.at_email;\n  const hsStatus = item.json.hs_billing_status;\n  const atStatus = item.json.at_billing_status;\n  const hsContactId = item.json.hs_contact_id;\n\n  // Record exists in HubSpot only — no Airtable counterpart to compare against\n  if (hsEmail && !atEmail) {\n    results.push({\n      json: {\n        email: hsEmail,\n        hs_contact_id: hsContactId,\n        note: \"Exists in HubSpot only\",\n        conflict: true\n      }\n    });\n    continue;\n  }\n\n  // Record exists in Airtable only — nothing to PATCH in HubSpot since there's no contact ID\n  if (atEmail && !hsEmail) {\n    results.push({\n      json: {\n        email: atEmail,\n        hs_contact_id: null,\n        note: \"Exists in Airtable only\",\n        conflict: true\n      }\n    });\n    continue;\n  }\n\n  // Record exists in both — compare and resolve\n  let resolvedBillingStatus;\n  let conflict = false;\n  if (hsStatus !== atStatus) {\n    conflict = true;\n    // Rule: billing/subscription status is owned by the support system\n    resolvedBillingStatus = atStatus;\n  } else {\n    resolvedBillingStatus = hsStatus;\n  }\n\n  results.push({\n    json: {\n      email: hsEmail,\n      hs_contact_id: hsContactId,\n      resolvedBillingStatus,\n      conflict\n    }\n  });\n}\nreturn results;"
      },
